<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen: the seal on the app's own ground, so there is no white
     flash before Flutter draws its first frame. The background colour has a
     night variant in values-night/colors.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>
